{
  "name": "@lastlook/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client SDK for the last-look competitive-fee AMM: quote, oracle bestOut, swap helpers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
