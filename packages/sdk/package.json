    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=20.12"
  },
  "peerDependencies": {
    "viem": "^2.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "viem": "^2.57.16",
    "vitest": "^3.0.9"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ]
